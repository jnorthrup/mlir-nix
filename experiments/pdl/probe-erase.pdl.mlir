module {
  pdl.pattern @EraseCallee : benefit(0) {
    %0 = type loc(#loc2)
    %1 = operands loc(#loc3)
    %2 = attribute = "__add" loc(#loc4)
    %3 = types loc(#loc3)
    %4 = operation "nix.builtin"(%1 : !pdl.range<value>)  {"name" = %2} -> (%3 : !pdl.range<type>) loc(#loc3)
    %5 = result 0 of %4 loc(#loc5)
    %6 = operand loc(#loc6)
    %7 = operand loc(#loc7)
    %8 = operation "nix.apply"(%5, %6, %7 : !pdl.value, !pdl.value, !pdl.value)  -> (%0 : !pdl.type) loc(#loc8)
    rewrite %8 {
      %9 = range %6, %7 : !pdl.value, !pdl.value  loc(#loc10)
      %10 = operation "nixnum.add"(%9 : !pdl.range<value>)  -> (%0 : !pdl.type) loc(#loc11)
      replace %8 with %10 loc(#loc12)
      erase %4 loc(#loc13)
    } loc(#loc9)
  } loc(#loc1)
} loc(#loc)
