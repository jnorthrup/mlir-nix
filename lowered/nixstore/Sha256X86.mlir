// SHA-256's rounds by the x86 SHA extensions (SHA-NI): the hardware form Sha256.mlir's @s256_blocks calls where
// @s256_hw_probe says the CPU has them.  llvm dialect (a scalar core), lowered by mlnix_lower_interface; the rounds'
// function carries the target features, so the module compiles for the baseline x86-64 target.
//   s256_hw_probe()              cpuid: leaf 7 exists and its EBX bit 29 (SHA) is set, with leaf 1's ECX bits 9 (SSSE3) and
//                                19 (SSE4.1): 2, else 1
//   s256_hw_blocks(ctx, p, nb)   h = ctx[0..8) i32; nb whole 64-byte blocks at p.  The state stays in two vector
//                                registers in the order sha256rnds2 wants, (f, e, b, a) and (h, g, d, c), across the
//                                blocks.  A block is four vectors of big-endian words; each of the sixteen four-round
//                                groups adds its K words to its schedule vector w, and sha256rnds2 runs twice (the sum's
//                                low and high halves); from the fifth group on,
//                                w[g] = sha256msg2(sha256msg1(w[g-4], w[g-3]) + (w[g-2], w[g-1])[1..5), w[g-1]).
// Generated by scratch sha256hw/gen_sha256.py (the constants from their definitions); this file is the source.

llvm.mlir.global internal constant @s256_x86_k(dense<[
  1116352408, 1899447441, -1245643825, -373957723, 961987163, 1508970993, -1841331548, -1424204075, -670586216,
  310598401, 607225278, 1426881987, 1925078388, -2132889090, -1680079193, -1046744716, -459576895, -272742522,
  264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, -1740746414, -1473132947, -1341970488,
  -1084653625, -958395405, -710438585, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291,
  1695183700, 1986661051, -2117940946, -1838011259, -1564481375, -1474664885, -1035236496, -949202525, -778901479,
  -694614492, -200395387, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063,
  1747873779, 1955562222, 2024104815, -2067236844, -1933114872, -1866530822, -1538233109, -1090935817, -965641998]> : tensor<64xi32>) {alignment = 64 : i64} : !llvm.array<64 x i32>

llvm.func @s256_hw_probe() -> i64 {
  %z = llvm.mlir.constant(0 : i32) : i32
  %l1 = llvm.mlir.constant(1 : i32) : i32
  %l7 = llvm.mlir.constant(7 : i32) : i32
  %one = llvm.mlir.constant(1 : i64) : i64
  %two = llvm.mlir.constant(2 : i64) : i64
  %r0 = llvm.inline_asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx},~{dirflag},~{fpsr},~{flags}" %z, %z : (i32, i32) -> !llvm.struct<(i32, i32, i32, i32)>
  %max = llvm.extractvalue %r0[0] : !llvm.struct<(i32, i32, i32, i32)>
  %has7 = llvm.icmp "uge" %max, %l7 : i32
  llvm.cond_br %has7, ^leaves, ^no
^leaves:
  %r1 = llvm.inline_asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx},~{dirflag},~{fpsr},~{flags}" %l1, %z : (i32, i32) -> !llvm.struct<(i32, i32, i32, i32)>
  %r7 = llvm.inline_asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx},~{dirflag},~{fpsr},~{flags}" %l7, %z : (i32, i32) -> !llvm.struct<(i32, i32, i32, i32)>
  %ecx1 = llvm.extractvalue %r1[2] : !llvm.struct<(i32, i32, i32, i32)>
  %ebx7 = llvm.extractvalue %r7[1] : !llvm.struct<(i32, i32, i32, i32)>
  %need1 = llvm.mlir.constant(524800 : i32) : i32
  %need7 = llvm.mlir.constant(536870912 : i32) : i32
  %got1 = llvm.and %ecx1, %need1 : i32
  %got7 = llvm.and %ebx7, %need7 : i32
  %ok1 = llvm.icmp "eq" %got1, %need1 : i32
  %ok7 = llvm.icmp "eq" %got7, %need7 : i32
  %ok = llvm.and %ok1, %ok7 : i1
  %form = llvm.select %ok, %two, %one : i1, i64
  llvm.return %form : i64
^no:
  llvm.return %one : i64
}

