  %m15 = llvm.call_intrinsic "llvm.x86.sha256msg1"(%w11, %w12) : (vector<4xi32>, vector<4xi32>) -> vector<4xi32>
  %x15 = llvm.shufflevector %w13, %w14 [1, 2, 3, 4] : vector<4xi32>
  %y15 = llvm.add %m15, %x15 : vector<4xi32>
  %w15 = llvm.call_intrinsic "llvm.x86.sha256msg2"(%y15, %w14) : (vector<4xi32>, vector<4xi32>) -> vector<4xi32>
  %k15 = llvm.getelementptr inbounds %k[240] : (!llvm.ptr) -> !llvm.ptr, i8
  %kv15 = llvm.load %k15 {alignment = 16 : i64} : !llvm.ptr -> vector<4xi32>
  %t15 = llvm.add %w15, %kv15 : vector<4xi32>
  %th15 = llvm.shufflevector %t15, %t15 [2, 3, 2, 3] : vector<4xi32>
  %q15 = llvm.call_intrinsic "llvm.x86.sha256rnds2"(%q14, %r14, %t15) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
  %r15 = llvm.call_intrinsic "llvm.x86.sha256rnds2"(%r14, %q15, %th15) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
  %feba1 = llvm.add %feba, %r15 : vector<4xi32>
  %hgdc1 = llvm.add %hgdc, %q15 : vector<4xi32>
  %i1 = llvm.add %i, %c1 : i64
  llvm.br ^head(%i1, %feba1, %hgdc1 : i64, vector<4xi32>, vector<4xi32>)
^done:
  %abcd = llvm.shufflevector %feba, %hgdc [3, 2, 7, 6] : vector<4xi32>
  %efgh = llvm.shufflevector %feba, %hgdc [1, 0, 5, 4] : vector<4xi32>
  llvm.store %abcd, %ctx {alignment = 4 : i64} : vector<4xi32>, !llvm.ptr
  llvm.store %efgh, %hp {alignment = 4 : i64} : vector<4xi32>, !llvm.ptr
  llvm.return
}
