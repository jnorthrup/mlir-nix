  %two = llvm.mlir.constant(2 : i64) : i64
  %need1 = llvm.mlir.constant(524800 : i32) : i32
  %need7 = llvm.mlir.constant(536870912 : i32) : i32
  %r0 = llvm.inline_asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx},~{dirflag},~{fpsr},~{flags}" %z, %z : (i32, i32) -> !llvm.struct<(i32, i32, i32, i32)>
  %max = llvm.extractvalue %r0[0] : !llvm.struct<(i32, i32, i32, i32)>
  %has7 = llvm.icmp "uge" %max, %l7 : i32
  llvm.cond_br %has7, ^leaves, ^no
^leaves:
  %r1 = llvm.inline_asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx},~{dirflag},~{fpsr},~{flags}" %l1, %z : (i32, i32) -> !llvm.struct<(i32, i32, i32, i32)>
  %r7 = llvm.inline_asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx},~{dirflag},~{fpsr},~{flags}" %l7, %z : (i32, i32) -> !llvm.struct<(i32, i32, i32, i32)>
  %ecx1 = llvm.extractvalue %r1[2] : !llvm.struct<(i32, i32, i32, i32)>
  %ebx7 = llvm.extractvalue %r7[1] : !llvm.struct<(i32, i32, i32, i32)>
  %got1 = llvm.and %ecx1, %need1 : i32
  %got7 = llvm.and %ebx7, %need7 : i32
  %ok1 = llvm.icmp "eq" %got1, %need1 : i32
  %ok7 = llvm.icmp "eq" %got7, %need7 : i32
  %ok = llvm.and %ok1, %ok7 : i1
  %form = llvm.select %ok, %two, %one : i1, i64
  llvm.return %form : i64
^no:
  llvm.return %one : i64
}

