// SHA-256's rounds of one block by the x86 SHA extensions (SHA-NI): Sha256.mlir's @s256_hw_block where @s256_hw_probe
// says the CPU has them.  llvm dialect (a scalar core), lowered by mlnix_lower_interface; the rounds' function carries
// the target features, so the module compiles for the baseline x86-64 target.
//   s256_hw_probe()   cpuid: leaf 7 exists and its EBX bit 29 (SHA) is set, with leaf 1's ECX bits 9 (SSSE3) and 19
//                     (SSE4.1): 2, else 1
//   s256_hw_block(abcd, efgh, p, k) -> (abcd, efgh)
//     The state's halves come in and go out as vectors, and are turned to the order sha256rnds2 wants, (f e b a) and
//     (h g d c), in between.  The block at p is four vectors of big-endian words; k is the 64-word K table (16-aligned).
//     Each of the sixteen four-round groups adds its K words to its schedule vector w, and sha256rnds2 runs twice (the
//     sum's low and high halves), each run overwriting the older half of the state; from the fifth group on,
//     w[g] = sha256msg2(sha256msg1(w[g-4], w[g-3]) + (w[g-2], w[g-1])[1..5), w[g-1]).
// Generated by the skill's scripts/sha256-gen.py; this file is the source.

llvm.func @s256_hw_probe() -> i64 {
  %z = llvm.mlir.constant(0 : i32) : i32
  %l1 = llvm.mlir.constant(1 : i32) : i32
  %l7 = llvm.mlir.constant(7 : i32) : i32
