    %v31 = arith.divui %j30, %cst12 : index
    %v32 = arith.remui %j30, %cst12 : index
    %v33 = arith.index_cast %v31 : index to i64
    %v34 = arith.index_cast %v32 : index to i32
    %p35 = llvm.getelementptr %ctx[%v33] : (!llvm.ptr, i64) -> !llvm.ptr, i32
    %l36 = llvm.load %p35 : !llvm.ptr -> i32
    %v37 = arith.muli %v34, %cst13 : i32
    %v38 = arith.subi %cst14, %v37 : i32
    %v39 = arith.shrui %l36, %v38 : i32
    %v40 = arith.trunci %v39 : i32 to i8
    trikeshed.yield %v40 : i8
  }
  %v41 = func.call @s256_desc(%out, %cst15) : (!llvm.ptr, i64) -> !d
  %v42 = builtin.unrealized_conversion_cast %v41 : !d to !m
  %v43 = trikeshed.drain %digest29, %v42 : !b, !m -> index
  return
}

