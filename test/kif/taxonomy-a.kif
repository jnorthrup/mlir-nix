; A small taxonomy for kif-trikeshed.mlir: sumo-nix's sumo.nix tables over two files, as TrikeShed's series.
(subclass Human Hominid)
(subclass Hominid Primate)
(subclass Primate Mammal)
(subclass Mammal Vertebrate)
(subclass Vertebrate Animal)
(subclass Animal Organism)
(subclass Human CognitiveAgent)
(subclass CognitiveAgent SentientAgent)
(subclass SentientAgent Agent)
(subclass Organism Agent)
(subclass (UnionFn Human Primate) Mammal)
(subclass Dog Mammal Extra)
(instance Socrates Human)
(instance Fido Dog)
(instance Socrates Philosopher)
(instance "a string" Text)
(domain teaches 1 Human)
(domain teaches 2 CognitiveAgent)
(domain mother 1 Organism)
(=> (instance ?X Human) (instance ?X Mammal))
(=> (and (instance ?X Dog) (owns ?Y ?X)) (instance ?Y Human))
(documentation Human EnglishLanguage "A person.")
